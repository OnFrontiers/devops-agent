# Jira API Configuration
JIRA_BASE_URL=https://onfrontiers.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here

# Optional: Project key if you want to focus on specific project
JIRA_PROJECT_KEY=ENG

# GitHub API Configuration
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_ORGANIZATION=onfrontiers

# Notion API Configuration
NOTION_API_KEY=your-notion-api-key-here
NOTION_DATABASE_ID=your-notion-database-id-here

# Optional: You can also specify a root page ID instead of a database
# NOTION_PAGE_ID=your-notion-page-id-here
